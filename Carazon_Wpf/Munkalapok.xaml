<Window
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="carazonGarage.Munkalapok"
             Background="#121417"
             WindowStyle="None">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" 
                    Margin="0,0,0,12">
            <TextBlock Text="Munkalapok" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#EAECEF" 
                       Margin="0,0,12,0"/>

            
            <DatePicker Margin="8,0,0,0" 
                        Foreground="#EAECEF" 
                        Background="#1A1D21"
                        Name="Datepicker_Szures"
                        SelectedDateChanged="DatePicker_Szures_SelectedDateChanged"/>

            <Button Content="Frissítés" 
                    Margin="12,0,0,0" 
                    Background="#3BA9FF" 
                    Foreground="White"
                    Name="Datepicker_Reset" Click="Datepicker_Reset_Click"/>
            <Button Content="Megnyitás" 
                    Margin="8,0,0,0" 
                    Background="#3BA9FF" 
                    Foreground="White"
                    Click="Megnyitas_Click"/>
            <Button Content="Kilépés" 
                    Margin="24,0,0,0" 
                    Background="Red" 
                    Foreground="White"
                    Click="Kilepes_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#1A1D21" 
                    CornerRadius="8" 
                    Padding="8" 
                    Grid.Column="0" 
                    Margin="0,0,12,0">
                <DataGrid av:ItemsSource="{av:SampleData ItemCount=5}"
                          Name="Datagrid_Munkalapok" SelectionChanged="Datagrid_Munkalapok_SelectionChanged"/>
            </Border>

            <Border Background="#1A1D21" 
                    CornerRadius="8" 
                    Padding="16" 
                    Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Status : Kész" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#EAECEF" 
                               Margin="0,0,0,8"
                               Name="Textblock_Keszvane"/>
                    <TextBlock Text="Cím:" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#EAECEF"
                               Name="TexBlock_Cim"/>
                    <TextBlock Text="Ügyfél: " 
                               Foreground="#A9B1BB" 
                               Margin="0,4,0,0"
                               Name="TexBlock_UgyfelNev"/>
                    <TextBlock Text="Rendszám:" 
                               Foreground="#A9B1BB"
                               Name="Textblocl_Rendszam"/>
                    <Separator Margin="0,8,0,8" 
                               Background="#2A2F36"/>
                    <TextBlock Text="Leírás" 
                               FontWeight="SemiBold" 
                               Foreground="#EAECEF"
                               Name="Leiras"/>
                    <TextBlock Text="" 
                               TextWrapping="Wrap" 
                               Foreground="#A9B1BB"
                               Name="Leiras_Content"/>
                    <Separator Margin="0,8,0,8" 
                               Background="#2A2F36"/>
                    <TextBlock Text="Státusz:" 
                               Foreground="#A9B1BB"
                               Name="Textblock_Status"/>
                    <TextBlock Text="Határidő:" 
                               Foreground="#A9B1BB" 
                               Margin="0,2,0,0"
                               Name="TexBlock_Hatarido"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
