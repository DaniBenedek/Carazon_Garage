<Window x:Class="carazonGarage.MunkalapReszletek"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Munkalap részletek"
        Width="480" Height="620"
        Background="#0F1114"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="10" 
            Background="#1A1D21" 
            Padding="16" 
            Margin="12" 
            BorderBrush="#2A2F36" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock Text="🔧 Munkalap részletek"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#EAECEF"
                           DockPanel.Dock="Left"/>

                <Button Content="✖"
                        Width="32" Height="32"
                        Foreground="#EAECEF"
                        Background="Transparent"
                        BorderBrush="#3A3F46"
                        HorizontalAlignment="Right"
                        Click="Kilpes_Click"/>
            </DockPanel>

            <StackPanel Grid.Row="1" 
                        Margin="0,10,0,10">

                <Border Background="#242830" 
                        Padding="12" 
                        CornerRadius="8" 
                        BorderBrush="#2A2F36" 
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="UgyfelNev" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#EAECEF"/>

                        <TextBlock x:Name="Rendszam"
                                   Foreground="#A9B1BB"
                                   Margin="0,4,0,0"/>

                        <TextBlock x:Name="Statusz"
                                   Foreground="#3BA9FF"
                                   Margin="0,4,0,0"/>

                        <TextBlock x:Name="Leiras"
                                   TextWrapping="Wrap"
                                   Foreground="#A9B1BB"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Elvégzett munkák"
                           Margin="0,16,0,8"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="#EAECEF"/>

                <StackPanel Margin="0,4,0,0">
                    <CheckBox Content="🛢 Olajcsere" 
                              Foreground="#EAECEF" 
                              Margin="0,6,0,2"/>
                    <CheckBox Content="🛞 Féktárcsa / betét csere" 
                              Foreground="#EAECEF" 
                              Margin="0,6,0,2"/>
                    <CheckBox Content="🧰 Általános szerviz" 
                              Foreground="#EAECEF" 
                              Margin="0,6,0,2"/>
                    <CheckBox Content="🌡 Diagnosztika" 
                              Foreground="#EAECEF" 
                              Margin="0,6,0,2"/>
                    <CheckBox Content="❄ Klíma töltés" 
                              Foreground="#EAECEF" 
                              Margin="0,6,0,2"/>
                    <CheckBox Content="⚙ Kuplung csere" 
                              Foreground="#EAECEF" 
                              Margin="0,6,0,2"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="Kilépés"
                        Width="110"
                        Margin="0,0,8,0"
                        Background="#2A2F36"
                        Foreground="#EAECEF"
                        BorderThickness="0"
                        Click="Kilpes_Click"/>

                <Button Content="Mentés"
                        Width="110"
                        Background="#3BD37F"
                        Foreground="#121417"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="Mentes_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
