<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="av" 
        x:Class="carazonGarage.Alkatreszek"
        Title="Alkatrészek"
        Width="1000" 
        Height="700"
        Background="#121417">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" 
                    Margin="0,0,0,12">
            <TextBlock Text="Alkatrészek" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#EAECEF" 
                       Margin="0,0,12,0"/>

            <Button Content="Új alkatrész" 
                    Margin="12,0,0,0" 
                    Background="#3BA9FF" 
                    Foreground="White" 
                    Click="Button_NewPart"/>
            
            <Button Content="Készlet frissítés" 
                    Margin="12,0,0,0" 
                    Background="#3BA9FF" 
                    Foreground="White"
                    Click="Button_UpdatePart"/>

            <Button Content="Kilépés" 
                    Margin="8,0,0,0" 
                    Background="Red" 
                    Foreground="White" 
                    Click="Alkatreszek_kilepes"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#1A1D21" 
                    CornerRadius="8" 
                    Padding="8" 
                    Grid.Column="0" 
                    Margin="0,0,12,0">
                <DataGrid av:ItemsSource="{av:SampleData ItemCount=5}" 
                          SelectionChanged="DataGrid_Alkatreszek_SelectionChanged"
                          Name="Datagrid_Alkatreszek"
                          AutoGenerateColumns="True"/>
            </Border>

            <Border Background="#1A1D21" 
                    CornerRadius="8" 
                    Padding="16" 
                    Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Részletek" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#EAECEF" 
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="Név:" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#EAECEF"
                               Name="TextBlock_Name"/>
                    
                    <TextBlock Text="Cikkszám:"
                               Foreground="#A9B1BB" 
                               Margin="0,4,0,0"
                               Name="TextBlock_Cikkszam"/>
                    
                    <TextBlock Text="Kategória:" 
                               Foreground="#A9B1BB"
                               Name="Textblock_Category"/>
                    
                    <Separator Margin="0,8,0,8" 
                               Background="#2A2F36"/>
                    
                    <TextBlock Text="Leírás" 
                               FontWeight="SemiBold" 
                               Foreground="#EAECEF"/>
                    
                    <TextBlock Text="" 
                               TextWrapping="Wrap" 
                               Foreground="#A9B1BB"
                               Name="Textblock_Description"/>
                    
                    <Separator Margin="0,8,0,8" 
                               Background="#2A2F36"/>
                    
                    <TextBlock Text="Egységár:"
                               Foreground="#A9B1BB"
                               Name="Textblock_Price"/>
                    
                    <TextBlock Text="Készlet:" 
                               Foreground="#A9B1BB"
                               Name="Textblock_Quanity"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
