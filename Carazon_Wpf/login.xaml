<Window x:Class="carazonGarage.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bejelentkezés" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#121417">

    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Bejelentkezés" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <TextBlock Text="Felhasználónév" Foreground="#A9B1BB"/>
            <TextBox Name="TxtUsername" Margin="0,4,0,12" Background="#2A2F36" Foreground="White"/>
            <TextBlock Text="Jelszó" Foreground="#A9B1BB"/>
            <PasswordBox Name="TxtPassword" Margin="0,4,0,20" Background="#2A2F36" Foreground="White"/>
            <Button Content="Bejelentkezés" Background="#3BA9FF" Foreground="White" Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
