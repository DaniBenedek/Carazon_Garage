<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="av" 
        x:Class="carazonGarage.MainWindow"
        Title="CarazonGarage" 
        Width="1200" 
        Height="800"
        Background="#121417">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" 
                Grid.Row="0"
                Background="#1A1D21"
                BorderBrush="#2A2F36" 
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="16,0" 
                            Grid.Column="0">
                    <TextBlock Text="CarazonGarage" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#EAECEF"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="16,0" 
                            Grid.Column="1">
                    <Border Background="#181B1F" 
                            CornerRadius="16" 
                            Padding="8">
                        <DockPanel>
                            <TextBlock Text="Keresés" 
                                       Foreground="#A9B1BB" 
                                       Margin="0,0,8,0" 
                                       FontSize="18"/>
                            <TextBox Width="320" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="#EAECEF"
                                     CaretBrush="#3BA9FF" 
                                     Text="" TextChanged="TextBox_TextChanged"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center" 
                            Margin="16,0" 
                            Grid.Column="2">
                    <TextBlock Text="" 
                               Foreground="#A9B1BB" 
                               Margin="0,0,12,0" 
                               FontSize="18"
                               Name="Texblock_User"/>
                    <Ellipse Width="28" 
                             Height="28" 
                             Fill="#3BA9FF"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Grid.Column="0" 
                Background="#14171B" 
                BorderBrush="#2A2F36" 
                BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <TextBlock Text="Navigáció" 
                           Foreground="#A9B1BB" 
                           Margin="8,8,8,16"/>

                <Button Content="Főoldal" 
                        Margin="0,4" 
                        Background="Transparent" 
                        Foreground="#EAECEF" 
                        BorderThickness="0" 
                        FontSize="18"/>

                <Button Content="Ügyfelek" 
                        Margin="0,4" 
                        Background="Transparent" 
                        Foreground="#EAECEF" 
                        BorderThickness="0" 
                        Click="Ugyfelek_Click" 
                        FontSize="18"/>

                <Button Content="Munkalapok" 
                        Margin="0,4" 
                        Background="Transparent" 
                        Foreground="#EAECEF" 
                        BorderThickness="0" 
                        Click="Munkalapok_Click" 
                        FontSize="18"/>

                <Button Content="Alkatrészek" 
                        Margin="0,4" 
                        Background="Transparent" 
                        Foreground="#EAECEF" 
                        BorderThickness="0" 
                        Click="Alkatreszek_Click" 
                        FontSize="18"/>

                <Button Content="Bejelentkezés" 
                        Margin="0,4" 
                        Background="Transparent" 
                        Foreground="#EAECEF" 
                        BorderThickness="0" 
                        Click="Alkatreszek_Bejelentkezes" 
                        FontSize="18"/>
                
                <Button Content="Kilépés" 
                        Background="#FFDC1C1C" 
                        Foreground="#EAECEF" 
                        BorderThickness="0" 
                        Click="Kilepes_Click" 
                        FontSize="18"/>

            </StackPanel>
        </Border>

        <Border Grid.Row="1" 
                Grid.Column="1" 
                Padding="16" 
                Background="#121417">
            <DataGrid Name="Datagrid_Szerviz" 
                      av:ItemsSource="{av:SampleData ItemCount=5}"/>
        </Border>
    </Grid>
</Window>
